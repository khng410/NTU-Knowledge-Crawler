    <ntu:hasSanction rdf:resource="https://ontology.ntu.edu.vn/resource/d47599adf8cb0233feffcfb300ddd04aadf34e53fb943d8c1655b4f9a8b55e8e"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ontology.ntu.edu.vn/resource/d556e0ecf41888441c1fac43c05b7882f27e582d0ba936dff4245a001dc05157">
    <rdf:type rdf:resource="https://ontology.ntu.edu.vn/academic#DisciplineRule"/>
    <rdfs:label>QĐ 1351 - 3.3</rdfs:label>
    <ntu:factType>discipline_rule</ntu:factType>
    <ntu:content>Tự ý tổ chức uống rượu, bia trong khuôn viên Trường; say rượu, bia khi đến lớp học.; lần 1: nhắc nhở; lần 2: khiển trách; lần 3: cảnh cáo; lần 4: đình chỉ học tập có thời hạn; lần 5: buộc thôi học</ntu:content>
    <ntu:sourceUrl>https://phongctsv.ntu.edu.vn/uploads/46/files/2025/269-Q%C4%90%201351_Q%C4%90%20V%C4%83n%20h%C3%B3a%20h%E1%BB%8Dc%20%C4%91%C6%B0%E1%BB%9Dng%202025.pdf</ntu:sourceUrl>
