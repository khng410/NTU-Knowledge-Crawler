  <rdf:Description rdf:about="https://ontology.ntu.edu.vn/resource/1e18503e5a4a7c9c3057381af3357006a8fe8d8655ecbf420adb8f7c96a4ecd6">
    <rdf:type rdf:resource="https://ontology.ntu.edu.vn/academic#DisciplineRule"/>
    <rdfs:label>QĐ 1351 - 3.1</rdfs:label>
    <ntu:factType>discipline_rule</ntu:factType>
    <ntu:content>Xả rác bừa bãi, viết, vẽ lên bàn, tường trong các phòng học, phòng họp, phòng ở ký túc xá và các khu vực khác trong khuôn viên Trường.; lần 1: nhắc nhở; lần 2: khiển trách; lần 3: cảnh cáo; lần 4: đình chỉ học tập có thời hạn</ntu:content>
    <ntu:sourceUrl>https://phongctsv.ntu.edu.vn/uploads/46/files/2025/269-Q%C4%90%201351_Q%C4%90%20V%C4%83n%20h%C3%B3a%20h%E1%BB%8Dc%20%C4%91%C6%B0%E1%BB%9Dng%202025.pdf</ntu:sourceUrl>
